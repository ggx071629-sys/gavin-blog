NUXT_PUBLIC_API_BASE=/api/v1
NUXT_API_UPSTREAM=http://127.0.0.1:8000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Public assistant proxy identity is default-off in practice: the assistant
# route returns 503 unless a trusted edge CIDR, dedicated edge header, dedicated
# API header, and shared proxy HMAC secret are explicitly configured.
# NUXT_PUBLIC_ASSISTANT_UI_ENABLED=false
# NUXT_ASSISTANT_TRUSTED_EDGE_PROXIES=127.0.0.1/32
# NUXT_ASSISTANT_EDGE_CLIENT_IP_HEADER=X-Gavin-Edge-Client-IP
# NUXT_ASSISTANT_API_CLIENT_IP_HEADER=X-Gavin-Client-IP
# NUXT_ASSISTANT_PROXY_HMAC_SECRET=
