{
  "name": "@gavin/web",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt prepare && node scripts/fix-nuxt-tsconfig-paths.mjs && vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:quality": "playwright test --config playwright.quality.config.ts",
    "test:failure-states": "playwright test --config playwright.failure.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-table-of-contents": "^0.6.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.12.0",
    "nuxt": "4.5.1",
    "vue": "^3.5.22",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.55.0",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@vue/test-utils": "^2.4.6",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.1",
    "lighthouse": "^13.4.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
