DEEPSEEK_API_KEY=""
# 真实 Key 只填写在本机 .env 顶部，模板保持空白。
# DeepSeek (OpenAI 兼容) 第三方 LLM 配置
# 需要使用时，在 .env 中取消下列四项的注释。
# GAVIN_ASSISTANT_CHAT_PROVIDER=openai-compatible
# GAVIN_ASSISTANT_CHAT_ENDPOINT=https://api.deepseek.com
# GAVIN_ASSISTANT_CHAT_MODEL=deepseek-v4-flash
# GAVIN_ASSISTANT_CHAT_API_KEY=${DEEPSEEK_API_KEY}
# 官方参数参考：https://api-docs.deepseek.com/zh-cn/
# 连接配置不自动启用在线问答，严格结构化输出兼容性仍需验证。

GAVIN_ENVIRONMENT=development
GAVIN_DATABASE_URL=sqlite:///./data/gavin.db
GAVIN_ADMIN_USERNAME=gavin
GAVIN_ADMIN_PASSWORD=replace-with-a-long-random-secret
GAVIN_SESSION_TTL_HOURS=24
GAVIN_LOGIN_LIMIT=5
GAVIN_LOGIN_WINDOW_SECONDS=300
GAVIN_COOKIE_SECURE=false
GAVIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GAVIN_MEDIA_ROOT=./data/media
GAVIN_MEDIA_MAX_BYTES=10485760
GAVIN_MEDIA_MAX_PIXELS=40000000
# Production must set an absolute path shared by the API and index Worker.
# GAVIN_CONTENT_WRITE_FENCE_PATH=
# Assistant hybrid index is default-off internal infrastructure. Do not enable
# the worker without an explicit provider, model, dimension, credentials, and a
# private Qdrant URL. The test embedding provider is not a production model.
# GAVIN_ASSISTANT_INDEX_WORKER_ENABLED=false
# GAVIN_ASSISTANT_EMBEDDING_PROVIDER=openai-compatible
# GAVIN_ASSISTANT_EMBEDDING_MODEL=
# GAVIN_ASSISTANT_EMBEDDING_MODEL_VERSION=
# GAVIN_ASSISTANT_EMBEDDING_DIMENSION=
# GAVIN_ASSISTANT_EMBEDDING_MAX_BATCH_ITEMS=
# GAVIN_ASSISTANT_EMBEDDING_PROVIDER_MAX_CONCURRENCY=
# GAVIN_ASSISTANT_EMBEDDING_ENDPOINT=
# GAVIN_ASSISTANT_EMBEDDING_API_KEY=
# GAVIN_ASSISTANT_EMBEDDING_INPUT_PRICE_CNY_PER_MILLION=
# GAVIN_ASSISTANT_QDRANT_URL=
# GAVIN_ASSISTANT_QDRANT_API_KEY=
# Development/test only: use a process-private embedded Qdrant path. Production
# requires the authenticated remote URL above and rejects an embedded path.
# GAVIN_ASSISTANT_QDRANT_PATH=
# GAVIN_ASSISTANT_QDRANT_VOLUME=
# GAVIN_ASSISTANT_QDRANT_TIMEOUT_SECONDS=
# GAVIN_ASSISTANT_QDRANT_COLLECTION_PREFIX=
# GAVIN_ASSISTANT_PIPELINE_VERSION=assistant-index-v1
# GAVIN_ASSISTANT_CHUNK_SIZE=800
# GAVIN_ASSISTANT_CHUNK_OVERLAP=120
# GAVIN_ASSISTANT_INDEX_LEASE_SECONDS=30
# GAVIN_ASSISTANT_INDEX_MAX_ATTEMPTS=8
# GAVIN_ASSISTANT_INDEX_POLL_SECONDS=0.5
# Public Q&A online core is default-off. Enabling it requires explicit Chat and
# Embedding identity, prices, Beijing-day budgets, origin, HMAC secrets, a
# provisioned assistant_runtime SQLite, an exact reviewed qualification profile,
# a reviewed real-provider probe, and a readiness receipt. OpenAPI routes do not
# mean a live provider is available. assistant_runtime is intentionally not backed up.
# GAVIN_ASSISTANT_ONLINE_ENABLED=false
# Local offline development is normally enabled only by the root
# `npm run dev:assistant` supervisor; it is rejected outside development.
# GAVIN_ASSISTANT_LOCAL_DEV_MODE=false
# GAVIN_ASSISTANT_SINGLE_PROCESS_CONFIRMED=false
# GAVIN_ASSISTANT_RUNTIME_PATH=
# GAVIN_ASSISTANT_PUBLIC_ORIGIN=
# GAVIN_ASSISTANT_TRUSTED_PROXIES=127.0.0.1/32
# GAVIN_ASSISTANT_CLIENT_IP_HEADER=X-Gavin-Client-IP
# GAVIN_ASSISTANT_PROXY_HMAC_SECRET=
# GAVIN_ASSISTANT_PROXY_MAX_CLOCK_SKEW_SECONDS=10
# GAVIN_ASSISTANT_SSE_HEARTBEAT_SECONDS=15
# GAVIN_ASSISTANT_IP_HMAC_SECRET=
# GAVIN_ASSISTANT_SESSION_HMAC_SECRET=
# GAVIN_ASSISTANT_CSRF_HMAC_SECRET=
# GAVIN_ASSISTANT_READINESS_HMAC_SECRET=
# GAVIN_ASSISTANT_QUALIFICATION_PROFILE_PATH=
# GAVIN_ASSISTANT_QUALIFICATION_PROFILE_DIGEST=sha256:<approved-profile-digest>
# GAVIN_ASSISTANT_PROVIDER_PROBE_SHA256=sha256:<reviewed-probe-digest>
# GAVIN_ASSISTANT_NTP_SERVICE=
# GAVIN_ASSISTANT_MAX_CLOCK_DRIFT_SECONDS=
# GAVIN_ASSISTANT_RELEASE_ID=
# GAVIN_ASSISTANT_POLICY_VERSION=assistant-online-v2
# Chat provider/model/endpoint/key 模板见文件顶部。
# Reviewed local DeepSeek example; production still requires its separate profile.
# GAVIN_ASSISTANT_CHAT_MODEL_VERSION=DeepSeek-V4-Flash-0731
# GAVIN_ASSISTANT_CHAT_PROVIDER_MAX_CONCURRENCY=3
# GAVIN_ASSISTANT_CHAT_MAX_INPUT_TOKENS=16000
# GAVIN_ASSISTANT_CHAT_MAX_OUTPUT_TOKENS=1024
# GAVIN_ASSISTANT_CHAT_CONTEXT_WINDOW_TOKENS=1000000
# Conservative peak, cache-miss prices; verify the provider price before changing them.
# GAVIN_ASSISTANT_CHAT_INPUT_PRICE_CNY_PER_MILLION=3
# GAVIN_ASSISTANT_CHAT_OUTPUT_PRICE_CNY_PER_MILLION=9
# GAVIN_ASSISTANT_CHAT_REPORTS_USAGE=true
# GAVIN_ASSISTANT_CHAT_REPORTS_FINISH_REASON=true
# GAVIN_ASSISTANT_CHAT_DAILY_BUDGET_CNY=2.00
# GAVIN_ASSISTANT_QUERY_EMBEDDING_DAILY_BUDGET_CNY=
# GAVIN_ASSISTANT_INDEX_EMBEDDING_DAILY_BUDGET_CNY=
# GAVIN_ASSISTANT_PROVIDER_TIMEOUT_SECONDS=
# GAVIN_ASSISTANT_RUNNER_CLEANUP_GRACE_SECONDS=
# GAVIN_ASSISTANT_QUESTION_MAX_CHARS=500
# GAVIN_ASSISTANT_RETRIEVE_LIMIT=8
# GAVIN_ASSISTANT_HISTORY_TURNS=4
# GAVIN_ASSISTANT_SESSION_IDLE_SECONDS=1800
# GAVIN_ASSISTANT_SESSION_ABSOLUTE_SECONDS=86400
# GAVIN_ASSISTANT_EVIDENCE_MAX_CHARS=6000
# GAVIN_ASSISTANT_LANGSMITH_TRACING=false
# Local real E5 retrieval: copy into ignored .env.e5; never enable Chat/gate here.
# GAVIN_ENVIRONMENT=development
# GAVIN_ASSISTANT_ONLINE_ENABLED=false
# GAVIN_ASSISTANT_INDEX_WORKER_ENABLED=true
# GAVIN_ASSISTANT_EMBEDDING_PROVIDER=openai-compatible
# GAVIN_ASSISTANT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# GAVIN_ASSISTANT_EMBEDDING_MODEL_VERSION=614241f622f53c4eeff9890bdc4f31cfecc418b3:e5-fp32-mean-l2-v1
# GAVIN_ASSISTANT_EMBEDDING_DIMENSION=384
# GAVIN_ASSISTANT_EMBEDDING_MAX_BATCH_ITEMS=1
# GAVIN_ASSISTANT_EMBEDDING_PROVIDER_MAX_CONCURRENCY=1
# GAVIN_ASSISTANT_EMBEDDING_ENDPOINT=http://127.0.0.1:8091/v1
# GAVIN_ASSISTANT_EMBEDDING_API_KEY=<same-secret-as-GAVIN_ASSISTANT_EMBEDDING_API_KEY>
# GAVIN_ASSISTANT_E5_MODEL_DIR=<absolute-model-directory>
# GAVIN_ASSISTANT_PIPELINE_VERSION=assistant-e5-token384-overlap64-v1
# GAVIN_ASSISTANT_CHUNK_SIZE=384
# GAVIN_ASSISTANT_CHUNK_OVERLAP=64
# GAVIN_ASSISTANT_EMBEDDING_INPUT_PRICE_CNY_PER_MILLION=0
# GAVIN_ASSISTANT_INDEX_EMBEDDING_DAILY_BUDGET_CNY=1
# GAVIN_ASSISTANT_PROVIDER_TIMEOUT_SECONDS=30
# GAVIN_ASSISTANT_QDRANT_URL=http://127.0.0.1:8092
# GAVIN_ASSISTANT_QDRANT_API_KEY=<independent-internal-secret>
# GAVIN_ASSISTANT_RUNTIME_PATH=<absolute-dedicated-runtime-file>
# 本地 E5 服务进程通过 GAVIN_ASSISTANT_E5_MODEL_DIR 与
# GAVIN_ASSISTANT_EMBEDDING_API_KEY 配置；不启用 Chat/公开问答 key。
## Account recovery (optional; keep real secrets only in the ignored local .env)
GAVIN_ADMIN_EMAIL=
GAVIN_SMTP_HOST=smtp.163.com
GAVIN_SMTP_PORT=465
GAVIN_SMTP_USERNAME=
GAVIN_SMTP_PASSWORD=
# Independent random secret, at least 32 characters. Never reuse the SMTP authorization code.
GAVIN_ACCOUNT_CODE_SECRET=

# 简历PDF下载只允许以下精确域名（逗号分隔）；默认为空，拒绝全部下载。
# GAVIN_ASSISTANT_RESUME_TRUSTED_HOSTS=files.example.com
