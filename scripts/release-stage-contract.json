{
  "schema_version": 1,
  "owner_gate": "release",
  "stages": [
    {
      "gate": "api-lint",
      "stage": "api-lint",
      "cwd": "apps/api",
      "command": ["{api_python}", "-m", "ruff", "check", "."]
    },
    {
      "gate": "api-typecheck",
      "stage": "api-typecheck",
      "cwd": "apps/api",
      "command": ["{api_python}", "-m", "mypy", "app"]
    },
    {
      "gate": "api-tests",
      "stage": "api-tests",
      "cwd": "apps/api",
      "command": ["{api_python}", "-m", "pytest"]
    },
    {
      "gate": "harness-tests",
      "stage": "harness-tests",
      "cwd": ".",
      "command": ["{api_python}", "-m", "pytest", "harness/verification/tests"]
    },
    {
      "gate": "web-quality",
      "stage": "web-quality",
      "cwd": ".",
      "command": ["npm", "run", "quality:web"]
    },
    {
      "gate": "e2e",
      "stage": "core-e2e",
      "cwd": ".",
      "command": ["npm", "run", "test:e2e"]
    },
    {
      "gate": "harness-integrity",
      "stage": "harness-integrity",
      "cwd": "harness",
      "command": ["{api_python}", "-m", "tools.harness", "verify"]
    }
  ]
}
