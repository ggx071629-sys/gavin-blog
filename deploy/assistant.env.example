# Optional runtime-only settings: copy to ROOT .env.assistant (chmod 600).
# Compose uses raw env_file: values are literal, no ${...} interpolation.
# Leave secret values empty in this tracked template.
# Requires compose.assistant.yaml and a target-specific schema 3 profile.
GAVIN_ADMIN_EMAIL=
GAVIN_SMTP_HOST=smtp.163.com
GAVIN_SMTP_PORT=465
GAVIN_SMTP_USERNAME=
GAVIN_SMTP_PASSWORD=
GAVIN_ACCOUNT_CODE_SECRET=
GAVIN_ASSISTANT_EMBEDDING_PROVIDER=openai-compatible
GAVIN_ASSISTANT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
GAVIN_ASSISTANT_EMBEDDING_MODEL_VERSION=614241f622f53c4eeff9890bdc4f31cfecc418b3:e5-fp32-mean-l2-v1
GAVIN_ASSISTANT_EMBEDDING_DIMENSION=384
GAVIN_ASSISTANT_EMBEDDING_MAX_BATCH_ITEMS=1
GAVIN_ASSISTANT_EMBEDDING_PROVIDER_MAX_CONCURRENCY=1
GAVIN_ASSISTANT_EMBEDDING_ENDPOINT=https://172.30.71.30:8091/v1
GAVIN_ASSISTANT_E5_CA_FILE=/run/assistant/e5-ca.crt
GAVIN_ASSISTANT_PIPELINE_VERSION=assistant-e5-token384-overlap64-v1
GAVIN_ASSISTANT_CHUNK_SIZE=384
GAVIN_ASSISTANT_CHUNK_OVERLAP=64
GAVIN_ASSISTANT_QDRANT_TIMEOUT_SECONDS=10
GAVIN_ASSISTANT_SINGLE_PROCESS_CONFIRMED=true
GAVIN_ASSISTANT_SSE_HEARTBEAT_SECONDS=15
GAVIN_ASSISTANT_PROVIDER_TIMEOUT_SECONDS=30
GAVIN_ASSISTANT_RUNNER_CLEANUP_GRACE_SECONDS=10
GAVIN_ASSISTANT_CHAT_PROVIDER=openai-compatible
GAVIN_ASSISTANT_CHAT_OUTPUT_PROTOCOL=deepseek-json-object
GAVIN_ASSISTANT_CHAT_ENDPOINT=
GAVIN_ASSISTANT_CHAT_MODEL=
GAVIN_ASSISTANT_CHAT_MODEL_VERSION=
GAVIN_ASSISTANT_CHAT_API_KEY=
GAVIN_ASSISTANT_CHAT_PROVIDER_MAX_CONCURRENCY=3
GAVIN_ASSISTANT_CHAT_MAX_INPUT_TOKENS=8000
GAVIN_ASSISTANT_CHAT_MAX_OUTPUT_TOKENS=512
GAVIN_ASSISTANT_CHAT_CONTEXT_WINDOW_TOKENS=1000000
GAVIN_ASSISTANT_CHAT_REPORTS_USAGE=true
GAVIN_ASSISTANT_CHAT_REPORTS_FINISH_REASON=true
# Fill prices/caps only after verifying your supplier and approving your budget.
GAVIN_ASSISTANT_CHAT_INPUT_PRICE_CNY_PER_MILLION=0
GAVIN_ASSISTANT_CHAT_OUTPUT_PRICE_CNY_PER_MILLION=0
GAVIN_ASSISTANT_CHAT_DAILY_BUDGET_CNY=0
GAVIN_ASSISTANT_QUERY_EMBEDDING_DAILY_BUDGET_CNY=0
GAVIN_ASSISTANT_INDEX_EMBEDDING_DAILY_BUDGET_CNY=0
GAVIN_ASSISTANT_EMBEDDING_INPUT_PRICE_CNY_PER_MILLION=0
GAVIN_ASSISTANT_IP_HMAC_SECRET=
GAVIN_ASSISTANT_SESSION_HMAC_SECRET=
GAVIN_ASSISTANT_CSRF_HMAC_SECRET=
GAVIN_ASSISTANT_READINESS_HMAC_SECRET=
GAVIN_ASSISTANT_QUALIFICATION_PROFILE_PATH=/run/assistant/profile.json
GAVIN_ASSISTANT_QUALIFICATION_PROFILE_DIGEST=
GAVIN_ASSISTANT_PROVIDER_PROBE_SHA256=
GAVIN_ASSISTANT_RELEASE_ID=
GAVIN_ASSISTANT_POLICY_VERSION=assistant-online-v2
GAVIN_ASSISTANT_NTP_SERVICE=
GAVIN_ASSISTANT_MAX_CLOCK_DRIFT_SECONDS=5
GAVIN_ASSISTANT_RESUME_TRUSTED_HOSTS=
